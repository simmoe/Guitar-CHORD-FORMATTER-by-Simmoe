// =====================================================================
// Fællesbandet / Chord Formatter — TILFØJELSER til projektets firestore.rules
// =====================================================================
//
// VIGTIGT: Firebase-projektet `p5-firebase-eebc1` er delt mellem
// mat-teacher, NEXT AI Design Hub og denne app. En `firebase deploy
// --only firestore:rules` ERSTATTER ALLE rules — derfor må disse
// blokke ALDRIG deployes alene.
//
// Workflow ved deploy (følges hver gang):
//   1. firebase firestore:rules:get --project p5-firebase-eebc1
//      (eller åbn Firebase Console → Firestore → Rules)
//   2. Kopiér de live rules ind som basis.
//   3. Indsæt blokkene herunder INDE i `match /databases/{database}/documents { ... }`.
//   4. Vis diff til Simo. Vent på godkendelse.
//   5. firebase deploy --only firestore:rules --project p5-firebase-eebc1
//   6. firebase firestore:rules:get igen og verificér.
//
// =====================================================================

// ---- Helpers (tilføj kun hvis de ikke findes i live rules) ----------
// function signedIn() { return request.auth != null; }

// ---- Fællesbandet / chord-formatter ---------------------------------
function isChordBandMember(bandId) {
	return signedIn()
		&& exists(/databases/$(database)/documents/chord_bands/$(bandId))
		&& request.auth.uid in get(/databases/$(database)/documents/chord_bands/$(bandId)).data.memberUids;
}

// User profil-doc'er (oprettes ved første login)
match /chord_users/{uid} {
	allow read:   if signedIn() && request.auth.uid == uid;
	allow create: if signedIn() && request.auth.uid == uid;
	allow update: if signedIn() && request.auth.uid == uid;
	// Sletning kun via admin / Cloud Function — ikke fra klient
	allow delete: if false;
}

// Band-dokument: oprettes manuelt fra Firebase Console (ejer: Simo).
// memberUids opdateres når et nyt medlem logger ind første gang.
match /chord_bands/{bandId} {
	allow read:   if isChordBandMember(bandId);
	// Kun bandets owner (resource.data.ownerUid) må opdatere medlemslisten.
	allow update: if signedIn()
	              && resource.data.ownerUid == request.auth.uid
	              && request.resource.data.ownerUid == resource.data.ownerUid;
	// Oprettelse/sletning sker via Console eller Cloud Function
	allow create: if false;
	allow delete: if false;

	// Sangbog
	match /songs/{songId} {
		allow read, write: if isChordBandMember(bandId);
	}

	// Sætlister
	match /setlists/{setlistId} {
		allow read, write: if isChordBandMember(bandId);
	}
}
